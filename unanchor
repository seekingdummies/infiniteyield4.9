    -- Function to teleport unanchored parts to a position
    function To(position)
        local Chr = Plr.Character
        if not Chr then return end
        
        local sound2 = Instance.new("Sound")
        sound2.SoundId = "rbxassetid://3398620867"
        sound2.Parent = game:GetService("SoundService")
        
        -- Check all parts in workspace
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and not part.Anchored then
                -- Exclude player's character parts
                if not part:IsDescendantOf(Chr) then
                    local partName = part.Name
                    local isCorePart = partName == "Torso" or partName == "Head" or 
                                     partName == "Right Arm" or partName == "Left Arm" or
                                     partName == "Right Leg" or partName == "Left Leg" or
                                     partName == "HumanoidRootPart"
                    
                    if not isCorePart then
                        part.CFrame = CFrame.new(position)
                        sound2:Play()
                        
                        if spam and not part:FindFirstChild("BodyGyro") then
                            local bodyPos = Instance.new("BodyPosition")
                            bodyPos.Position = part.Position
                            bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bodyPos.P = 1e6
                            bodyPos.Parent = part
                        end
                    end
                end
            end
        end
    end

