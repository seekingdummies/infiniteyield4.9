    -- Execute function for teleporting to player
    execute = function(name)
        local targetPlayer = game.Players:FindFirstChild(name)
        if not targetPlayer or not targetPlayer.Character then
            print("Player not found or has no character")
            return
        end
        
        local head = targetPlayer.Character:FindFirstChild("Head")
        if not head then
            print("Player has no head")
            return
        end
        
        local targetPos = head.Position
        
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and not part.Anchored then
                if not part:IsDescendantOf(game.Players.LocalPlayer.Character) then
                    local partName = part.Name
                    local isCorePart = partName == "Torso" or partName == "Head" or 
                                     partName == "Right Arm" or partName == "Left Arm" or
                                     partName == "Right Leg" or partName == "Left Leg" or
                                     partName == "HumanoidRootPart"
                    
                    if not isCorePart then
                        part.CFrame = CFrame.new(targetPos)
                    end
                end
            end
        end
    end

